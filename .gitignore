# ============================================================
# Local data — NEVER commit user images, datasets, models, or
# generated features/outputs to GitHub. (.gitkeep keeps the
# empty folder skeleton so the app still finds the paths.)
# ============================================================
data/illustrations_raw/*
!data/illustrations_raw/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/outputs/*
!data/outputs/.gitkeep
data/photos_raw/*
!data/photos_raw/.gitkeep
data/photos_masks/*
!data/photos_masks/.gitkeep
data/features/*
!data/features/.gitkeep
data/models/*
!data/models/.gitkeep

# Top-level generated data files
data/*.json
data/*.csv
data/*.parquet

# External assets / third-party datasets (Open Images, DeepFashion2, etc.)
external/

